# Database
DATABASE_URL=postgresql://cmc:cmc_dev_password@localhost:5432/cmc

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-min-32-character-secret
JWT_REFRESH_SECRET=change-this-to-another-min-32-character-secret

# Meilisearch (optional, fallback to PostgreSQL search)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=cmc_dev_meili_key

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cmc-media
S3_REGION=us-east-1

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# SMTP / Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cmc.io

# CORS
CORS_ORIGIN=http://localhost:3000

# Preview
PREVIEW_SECRET=change-this-preview-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANONYMOUS=100
RATE_LIMIT_MAX_AUTHENTICATED=500

# Logging
LOG_LEVEL=info